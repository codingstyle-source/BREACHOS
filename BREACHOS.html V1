<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>BREACHOS</title>
<style>
:root{
  --bg:#000000; --panel:#0d0d00; --text:#ffd400; --dim:#7a6600; --accent:#ffe14d;
  --err:#ff3b3b; --border:#4d4000; --win:#0a0a00; --winop:1; --wintint:0;
  color-scheme: dark;
}
*{box-sizing:border-box;}
html,body{height:100%;margin:0;}
body{
  background:var(--bg); color:var(--text);
  font-family:'Courier New',monospace;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  min-height:100%; overflow:hidden;
}
body.hiContrast{ --text:#fff700; --accent:#ffffff; --border:#ffffff; }
body.reduceMotion .bline, body.reduceMotion .anim{ animation:none !important; transition:none !important; }

/* ---------- BOOT SCREEN ---------- */
#boot{
  position:fixed; inset:0; background:#000; color:var(--text);
  font-size:12px; line-height:1.5; padding:24px; white-space:pre-wrap;
  z-index:200; overflow:hidden;
}
#boot .bline{opacity:0; animation:fadein .05s forwards;}
@keyframes fadein{to{opacity:1;}}
#bootbar{height:8px;border:1px solid var(--border);margin-top:14px;width:280px;max-width:80%;}
#bootfill{height:100%;width:0%;background:var(--accent);}
.hidden{display:none !important;}

/* ---------- DESKTOP ---------- */
#matrixCanvas{position:fixed; inset:0; z-index:0; display:none; opacity:.25;}
#scanlines{position:fixed; inset:0; z-index:1; pointer-events:none; display:none;
  background:repeating-linear-gradient(0deg, rgba(255,212,0,.06) 0px, rgba(255,212,0,.06) 1px, transparent 2px, transparent 3px);}
body.crtGlow #desktop, body.crtGlow .winBox{ text-shadow:0 0 6px rgba(255,225,77,.35); }
#desktop{position:fixed; inset:0; display:flex; flex-direction:column; z-index:2;}
#topbar{
  padding:10px 14px; border-bottom:1px solid var(--border);
  display:flex; justify-content:space-between; align-items:center;
  font-size:12px; letter-spacing:1px; flex-wrap:wrap; gap:6px;
  padding-top:calc(10px + env(safe-area-inset-top,0px));
  background:var(--bg); position:relative; z-index:3;
}
#topbar b{color:var(--accent)}
#logo{
  text-align:center; padding:28px 10px 6px; letter-spacing:6px; font-size:26px;
  font-weight:bold; color:var(--accent); text-shadow:0 0 10px rgba(255,225,77,.5);
}
#logo span{color:var(--text); font-size:11px; display:block; letter-spacing:3px; margin-top:4px; font-weight:normal;}
#icons{
  flex:1; display:grid; grid-template-columns:repeat(auto-fill,minmax(90px,1fr));
  gap:16px; padding:10px 24px 70px; align-content:start; max-width:760px; margin:0 auto; width:100%;
  overflow-y:auto;
}
.icon{
  display:flex; flex-direction:column; align-items:center; gap:6px; cursor:pointer;
  color:var(--text); font-size:11px; text-align:center; user-select:none;
}
.icon .glyph{
  width:52px; height:52px; border:1px solid var(--border); display:flex;
  align-items:center; justify-content:center; font-size:22px; background:var(--panel);
}
body.iconSmall .icon .glyph{width:38px;height:38px;font-size:16px;}
.icon:hover .glyph{border-color:var(--accent); color:var(--accent);}

/* ---------- TASKBAR ---------- */
#taskbar{
  position:fixed; left:0; right:0; bottom:0; z-index:40; display:flex; gap:6px;
  padding:8px; border-top:1px solid var(--border); background:var(--bg);
  padding-bottom:calc(8px + env(safe-area-inset-bottom,0px)); overflow-x:auto;
}
body.taskbarTop #taskbar{ bottom:auto; top:0; border-top:none; border-bottom:1px solid var(--border); }
body.taskbarTop #desktop{ padding-top:44px; }
.taskbtn{
  border:1px solid var(--border); background:var(--panel); color:var(--text); font-family:inherit;
  font-size:11px; padding:6px 10px; white-space:nowrap; cursor:pointer;
}
.taskbtn.active{border-color:var(--accent); color:var(--accent);}

/* ---------- WINDOWS ---------- */
.winBox{
  position:fixed; width:min(480px,92vw); background:var(--win); border:1px solid var(--border);
  z-index:10; box-shadow:0 6px 24px rgba(0,0,0,.6); opacity:var(--winop);
  backdrop-filter: blur(calc(var(--wintint) * 6px));
}
.winHead{
  display:flex; justify-content:space-between; align-items:center; cursor:grab;
  padding:8px 12px; border-bottom:1px solid var(--border); font-size:12px; color:var(--accent);
  background:var(--panel); touch-action:none;
}
.winHead:active{cursor:grabbing;}
.winBtns{display:flex; gap:6px;}
.winBtns span{cursor:pointer; border:1px solid var(--border); padding:1px 7px; color:var(--text); font-size:11px;}
.winBtns span:hover{color:var(--err); border-color:var(--err);}
.winBody{padding:14px; font-size:13px; line-height:1.6; max-height:60vh; overflow-y:auto;}
.winBody .out{white-space:pre-wrap; margin-top:10px; min-height:20px;}
.btn{
  background:var(--panel); color:var(--text); border:1px solid var(--border);
  padding:8px 14px; font-family:inherit; font-size:13px; cursor:pointer; margin:3px 4px 3px 0;
}
.btn:hover{border-color:var(--accent); color:var(--accent);}
.btn:disabled{opacity:.35; cursor:not-allowed;}
input.field, select.field{
  background:#000; border:1px solid var(--border); color:var(--text); font-family:inherit;
  padding:7px 8px; font-size:13px; width:100%; margin-top:6px;
}
.ok{color:var(--accent)} .err{color:var(--err)} .dim{color:var(--dim); font-size:12px;}
#progWrapTpl{display:none;}
.progWrap{height:6px;background:#000;border:1px solid var(--border);margin:8px 0;}
.progFill{height:100%;width:0%;background:var(--accent);}

/* terminal app */
.term{white-space:pre-wrap; font-size:13px; line-height:1.5; max-height:40vh; overflow-y:auto;}
.termInputRow{display:flex; gap:6px; margin-top:8px; border-top:1px solid var(--border); padding-top:8px;}
.termPrompt{color:var(--accent); white-space:nowrap;}
.termCmd{flex:1; background:transparent; border:none; outline:none; color:var(--text); font-family:inherit; font-size:13px;}

/* settings */
.setRow{display:flex; justify-content:space-between; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid #221d00; font-size:12px;}
.setRow label{flex:1;}
.setRow input[type=checkbox]{width:16px;height:16px; accent-color:var(--accent);}
.setRow input[type=range]{width:110px; accent-color:var(--accent);}
.setRow select{background:#000; color:var(--text); border:1px solid var(--border); font-family:inherit; font-size:11px;}
.setGroup{color:var(--accent); font-size:11px; letter-spacing:1px; margin:12px 0 2px; text-transform:uppercase;}
</style>
</head>
<body>

<canvas id="matrixCanvas"></canvas>
<div id="scanlines"></div>
<div id="boot"></div>

<div id="desktop" class="hidden">
  <div id="topbar"><span><b>BREACH_OS</b> v3.0 — target: self</span><span><span id="clock"></span> &nbsp; <span id="status">LOCKED · guest</span></span></div>
  <div id="logo">BREACHOS<span>SELF-TARGET EDITION</span></div>
  <div id="icons"></div>
</div>

<div id="taskbar"></div>

<script>
/* ================= shared state ================= */
let state={ scanned:false, hash:false, cracked:false, exploited:false, root:false, firewall:false, keylog:false };
let settings={
  accent:'#ffe14d', scanlines:false, crt:false, reduceMotion:false, sound:true, volume:0.5,
  terminalFont:13, winOpacity:1, winBlur:false, hiContrast:false, iconSmall:false,
  clock24:true, taskbarTop:false, matrixRain:false, confirmExploit:true, bootSkip:false,
  cursorBlink:true, showLogo:true, snapWindows:true, autoFocusTerm:true
};
const status=document.getElementById('status');
function updateStatus(){
  status.textContent = state.root ? 'UNLOCKED · root' : (state.exploited ? 'ESCALATING · breacher' : 'LOCKED · guest');
}
function beep(freq){
  if(!settings.sound) return;
  try{
    const ctx=beep.ctx||(beep.ctx=new (window.AudioContext||window.webkitAudioContext)());
    const o=ctx.createOscillator(), g=ctx.createGain();
    o.frequency.value=freq||440; o.type='square';
    g.gain.value=0.04*settings.volume;
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime+0.05);
  }catch(e){}
}

/* ================= boot sequence ================= */
const bootEl=document.getElementById('boot');
const bootLines=[
"  ____  ____  _____    _    ____ _   _  ___  ____  ",
" | __ )|  _ \\| ____|  / \\  / ___| | | |/ _ \\/ ___| ",
" |  _ \\| |_) |  _|   / _ \\| |   | |_| | | | \\___ \\ ",
" | |_) |  _ <| |___ / ___ \\ |___|  _  | |_| |___) |",
" |____/|_| \\_\\_____/_/   \\_\\____|_| |_|\\___/|____/ ",
"",
"BREACHOS BIOS v3.0 — SELF-TARGET EDITION",
"Copyright (c) //yellow-team",
"",
"Checking memory................. OK",
"Mounting /dev/self............... OK",
"Loading kernel modules:",
"  [ok] breachd-auth",
"  [ok] legacy-admin-panel",
"  [ok] debug-shell",
"Initializing self-referential attack surface...",
""
];
function bootLine(text,delay){
  return new Promise(res=>{
    const d=document.createElement('div');
    d.className='bline'; d.textContent=text;
    bootEl.appendChild(d);
    setTimeout(res,delay);
  });
}
async function boot(){
  for(const l of bootLines){ await bootLine(l, 60+Math.random()*40); }
  const barWrap=document.createElement('div'); barWrap.id='bootbar';
  const fill=document.createElement('div'); fill.id='bootfill';
  barWrap.appendChild(fill); bootEl.appendChild(barWrap);
  await bootLine('Loading toolkit...',10);
  await new Promise(res=>{
    let p=0;
    const t=setInterval(()=>{
      p+=Math.random()*16+8;
      if(p>=100){p=100;clearInterval(t);fill.style.width='100%';setTimeout(res,250);}
      else fill.style.width=p+'%';
    },70);
  });
  await bootLine('',80);
  await bootLine('Boot complete. Welcome, GUEST.',250);
  bootEl.style.transition='opacity .4s';
  bootEl.style.opacity='0';
  setTimeout(()=>{
    bootEl.classList.add('hidden');
    document.getElementById('desktop').classList.remove('hidden');
  },400);
}
boot();

/* ================= clock ================= */
function tickClock(){
  const d=new Date();
  let h=d.getHours(), m=String(d.getMinutes()).padStart(2,'0'), s=String(d.getSeconds()).padStart(2,'0');
  let txt;
  if(settings.clock24){ txt=String(h).padStart(2,'0')+':'+m+':'+s; }
  else { const am=h<12; h=h%12||12; txt=h+':'+m+':'+s+(am?' AM':' PM'); }
  document.getElementById('clock').textContent=txt;
}
setInterval(tickClock,1000); tickClock();

/* ================= matrix rain ================= */
const mCanvas=document.getElementById('matrixCanvas');
const mCtx=mCanvas.getContext('2d');
let mCols=[], mInterval=null;
function sizeCanvas(){ mCanvas.width=innerWidth; mCanvas.height=innerHeight; }
window.addEventListener('resize',sizeCanvas); sizeCanvas();
function startMatrix(){
  mCanvas.style.display='block';
  const fontSize=14; const cols=Math.floor(mCanvas.width/fontSize);
  mCols=new Array(cols).fill(0);
  if(mInterval) clearInterval(mInterval);
  mInterval=setInterval(()=>{
    mCtx.fillStyle='rgba(0,0,0,.08)'; mCtx.fillRect(0,0,mCanvas.width,mCanvas.height);
    mCtx.fillStyle=settings.accent; mCtx.font=fontSize+'px monospace';
    mCols.forEach((y,i)=>{
      const ch=String.fromCharCode(33+Math.random()*94);
      mCtx.fillText(ch, i*fontSize, y*fontSize);
      if(y*fontSize>mCanvas.height && Math.random()>0.975) mCols[i]=0; else mCols[i]=y+1;
    });
  },50);
}
function stopMatrix(){ mCanvas.style.display='none'; if(mInterval) clearInterval(mInterval); }

/* ================= apply settings ================= */
function applySettings(){
  document.documentElement.style.setProperty('--accent',settings.accent);
  document.documentElement.style.setProperty('--winop',settings.winOpacity);
  document.documentElement.style.setProperty('--wintint',settings.winBlur?1:0);
  document.getElementById('scanlines').style.display=settings.scanlines?'block':'none';
  document.body.classList.toggle('crtGlow',settings.crt);
  document.body.classList.toggle('reduceMotion',settings.reduceMotion);
  document.body.classList.toggle('hiContrast',settings.hiContrast);
  document.body.classList.toggle('iconSmall',settings.iconSmall);
  document.body.classList.toggle('taskbarTop',settings.taskbarTop);
  settings.matrixRain?startMatrix():stopMatrix();
  document.getElementById('logo').style.display=settings.showLogo?'block':'none';
  document.querySelectorAll('.term').forEach(t=>t.style.fontSize=settings.terminalFont+'px');
}

/* ================= window manager ================= */
let openWins={}; let zTop=10; let cascade=0;
function focusWin(id){
  const w=openWins[id]; if(!w) return;
  zTop++; w.el.style.zIndex=zTop;
  document.querySelectorAll('.taskbtn').forEach(b=>b.classList.toggle('active', b.dataset.id===id));
}
function toggleMinimize(id){
  const w=openWins[id]; if(!w) return;
  w.minimized=!w.minimized;
  w.el.style.display=w.minimized?'none':'block';
  if(!w.minimized) focusWin(id);
}
function closeWin(id){
  const w=openWins[id]; if(!w) return;
  if(w.cleanup) w.cleanup();
  w.el.remove(); delete openWins[id]; renderTaskbar();
}
function renderTaskbar(){
  const tb=document.getElementById('taskbar');
  tb.innerHTML='';
  Object.keys(openWins).forEach(id=>{
    const w=openWins[id];
    const b=document.createElement('button');
    b.className='taskbtn'; b.textContent=w.title; b.dataset.id=id;
    b.onclick=()=>{ if(w.minimized) toggleMinimize(id); else focusWin(id); };
    tb.appendChild(b);
  });
}
function spawnWindow(id,title,glyph){
  if(openWins[id]){ if(openWins[id].minimized) toggleMinimize(id); focusWin(id); return openWins[id].body; }
  const el=document.createElement('div');
  el.className='winBox';
  cascade=(cascade+1)%6;
  el.style.left=(20+cascade*26)+'px'; el.style.top=(70+cascade*26)+'px';
  el.innerHTML=`<div class="winHead"><span>${glyph} ${title}</span>
    <div class="winBtns"><span data-act="min">_</span><span data-act="close">✕</span></div></div>
    <div class="winBody"></div>`;
  document.body.appendChild(el);
  const body=el.querySelector('.winBody');
  openWins[id]={el,body,title,minimized:false};
  el.querySelector('[data-act="close"]').onclick=()=>closeWin(id);
  el.querySelector('[data-act="min"]').onclick=()=>toggleMinimize(id);
  el.onpointerdown=()=>focusWin(id);
  // drag
  const head=el.querySelector('.winHead');
  let dragging=false, sx=0, sy=0, ox=0, oy=0;
  head.addEventListener('pointerdown',e=>{
    if(e.target.closest('[data-act]')){ focusWin(id); return; }
    dragging=true; sx=e.clientX; sy=e.clientY;
    const r=el.getBoundingClientRect(); ox=r.left; oy=r.top;
    head.setPointerCapture(e.pointerId); focusWin(id);
  });
  head.addEventListener('pointermove',e=>{
    if(!dragging) return;
    let nx=ox+(e.clientX-sx), ny=oy+(e.clientY-sy);
    if(settings.snapWindows){ nx=Math.round(nx/10)*10; ny=Math.round(ny/10)*10; }
    nx=Math.max(0,Math.min(innerWidth-40,nx)); ny=Math.max(0,Math.min(innerHeight-40,ny));
    el.style.left=nx+'px'; el.style.top=ny+'px';
  });
  head.addEventListener('pointerup',()=>dragging=false);
  renderTaskbar(); focusWin(id);
  return body;
}

/* ================= desktop icons ================= */
const apps=[
  {id:'scanner', glyph:'◎', name:'Net Scanner'},
  {id:'hashdump', glyph:'▤', name:'Hash Dumper'},
  {id:'cracker', glyph:'✶', name:'Pass Cracker'},
  {id:'exploit', glyph:'⚡', name:'Exploit Kit'},
  {id:'rootlogin', glyph:'⚿', name:'Root Access'},
  {id:'terminal', glyph:'>_', name:'Terminal'},
  {id:'firewall', glyph:'▧', name:'Firewall'},
  {id:'monitor', glyph:'▥', name:'Monitor'},
  {id:'settings', glyph:'⚙', name:'Settings'},
];
const iconsEl=document.getElementById('icons');
apps.forEach(a=>{
  const el=document.createElement('div');
  el.className='icon';
  el.innerHTML=`<div class="glyph">${a.glyph}</div><div>${a.name}</div>`;
  el.onclick=()=>{ beep(600); openApp(a.id,a.name,a.glyph); };
  iconsEl.appendChild(el);
});
function openApp(id,title,glyph){
  const body=spawnWindow(id,title,glyph);
  if(id==='scanner') renderScanner(body);
  else if(id==='hashdump') renderHashdump(body);
  else if(id==='cracker') renderCracker(body);
  else if(id==='exploit') renderExploit(body);
  else if(id==='rootlogin') renderRootlogin(body);
  else if(id==='terminal') renderTerminal(body);
  else if(id==='firewall') renderFirewall(body);
  else if(id==='monitor') renderMonitor(body,id);
  else if(id==='settings') renderSettings(body);
}

async function runProgress(container,label,ms){
  if(settings.reduceMotion){ const d=document.createElement('div'); d.className='dim'; d.textContent=label+' done.'; container.appendChild(d); return; }
  const wrap=document.createElement('div'); wrap.className='progWrap';
  const fill=document.createElement('div'); fill.className='progFill';
  wrap.appendChild(fill);
  const lab=document.createElement('div'); lab.className='dim'; lab.textContent=label;
  container.appendChild(lab); container.appendChild(wrap);
  await new Promise(res=>{
    let p=0;
    const t=setInterval(()=>{
      p+=Math.random()*16+6;
      if(p>=100){p=100;clearInterval(t);fill.style.width='100%';setTimeout(res,200);}
      else fill.style.width=p+'%';
    },ms/12);
  });
}

/* ================= apps ================= */
function renderScanner(c){
  c.innerHTML = `<div class="dim">Probe BREACHOS for open attack surfaces on localhost.</div>
    <button class="btn" id="scanBtn">Run Scan</button>
    <div class="out" id="scanOut"></div>`;
  c.querySelector('#scanBtn').onclick=async(e)=>{
    e.target.disabled=true; beep(300);
    const out=c.querySelector('#scanOut');
    await runProgress(c,'Scanning ports on localhost...',1200);
    state.scanned=true;
    out.innerHTML = `PORT    STATE   SERVICE
22      open    breachd-auth (hardened)
8080    open    legacy-admin-panel  <span class="err">&lt;-- VULNERABLE</span>
31337   closed  debug-shell

<span class="ok">Scan complete. Port 8080 is exploitable.</span>`;
  };
}
function renderHashdump(c){
  c.innerHTML = `<div class="dim">Pull the root password hash from shadow memory.</div>
    <button class="btn" id="dumpBtn" ${state.scanned?'':'disabled'}>Dump Hash</button>
    ${state.scanned?'':'<div class="err dim">Requires Net Scanner results first.</div>'}
    <div class="out" id="dumpOut">${state.hash?'<span class="ok">root hash: 5f4dcc3b5aa765d61d8327deb882cf99</span>':''}</div>`;
  const btn=c.querySelector('#dumpBtn');
  if(btn) btn.onclick=async(e)=>{
    e.target.disabled=true; beep(300);
    const out=c.querySelector('#dumpOut');
    await runProgress(c,'Dumping shadow memory...',900);
    state.hash=true;
    out.innerHTML='<span class="ok">root hash: 5f4dcc3b5aa765d61d8327deb882cf99</span>';
  };
}
function renderCracker(c){
  c.innerHTML = `<div class="dim">Run a simulated dictionary attack on a captured hash.</div>
    <input class="field" id="hashIn" value="${state.hash?'5f4dcc3b5aa765d61d8327deb882cf99':''}">
    <button class="btn" id="crackBtn" ${state.hash?'':'disabled'}>Crack</button>
    ${state.hash?'':'<div class="err dim">Requires a dumped hash first.</div>'}
    <div class="out" id="crackOut">${state.cracked?'<span class="ok">cracked: "password"</span>':''}</div>`;
  const btn=c.querySelector('#crackBtn');
  if(btn) btn.onclick=async(e)=>{
    e.target.disabled=true; beep(300);
    const out=c.querySelector('#crackOut');
    await runProgress(c,'Running dictionary attack...',1800);
    state.cracked=true;
    out.innerHTML='<span class="ok">Match found! password = "password"</span>';
  };
}
function renderExploit(c){
  c.innerHTML = `<div class="dim">Fire a simulated exploit at a vulnerable port.</div>
    <button class="btn" id="expBtn" ${state.scanned?'':'disabled'}>Exploit port 8080 (legacy-admin-panel)</button>
    ${state.scanned?'':'<div class="err dim">Requires Net Scanner results first.</div>'}
    <div class="out" id="expOut">${state.exploited?'<span class="ok">Foothold gained — session: breacher</span>':''}</div>`;
  const btn=c.querySelector('#expBtn');
  if(btn) btn.onclick=async(e)=>{
    if(settings.confirmExploit && !confirm('Fire exploit at port 8080?')) return;
    if(state.firewall){ c.querySelector('#expOut').innerHTML='<span class="err">Blocked by firewall! Disable it first.</span>'; return; }
    e.target.disabled=true; beep(200);
    const out=c.querySelector('#expOut');
    await runProgress(c,'Firing exploit at 8080...',1600);
    state.exploited=true; updateStatus();
    out.innerHTML='<span class="ok">Foothold gained — session upgraded guest → breacher</span>';
  };
}
function renderRootlogin(c){
  const ready = state.cracked && state.exploited;
  c.innerHTML = `<div class="dim">Authenticate as root using your cracked credentials.</div>
    <input class="field" id="pwIn" placeholder="password" ${ready?'':'disabled'}>
    <button class="btn" id="loginBtn" ${ready?'':'disabled'}>Login as root</button>
    ${ready?'':'<div class="err dim">Requires a foothold (Exploit Kit) and a cracked password (Password Cracker).</div>'}
    <div class="out" id="loginOut">${state.root?'<span class="ok">root@breachos — ACCESS GRANTED</span>':''}</div>`;
  const btn=c.querySelector('#loginBtn');
  if(btn) btn.onclick=async(e)=>{
    const pw=c.querySelector('#pwIn').value;
    const out=c.querySelector('#loginOut');
    if(pw!=='password'){ out.innerHTML='<span class="err">Access denied: wrong password.</span>'; beep(120); return; }
    e.target.disabled=true;
    await runProgress(c,'Authenticating as root...',800);
    state.root=true; updateStatus(); beep(800);
    out.innerHTML='<span class="ok">=== ACCESS GRANTED — root@breachos ===</span>\n<span class="ok">You breached BREACHOS using its own toolkit.</span>';
  };
}
function renderFirewall(c){
  c.innerHTML = `<div class="dim">Toggle the legacy-admin-panel firewall. Enabled, it blocks the Exploit Kit.</div>
    <button class="btn" id="fwBtn">${state.firewall?'Disable Firewall':'Enable Firewall'}</button>
    <div class="out" id="fwOut">Status: <span class="${state.firewall?'ok':'err'}">${state.firewall?'ACTIVE':'DOWN'}</span></div>`;
  c.querySelector('#fwBtn').onclick=(e)=>{
    state.firewall=!state.firewall; beep(400);
    renderFirewall(c);
  };
}

function renderMonitor(c,winId){
  c.innerHTML = `<div class="dim">Live system load on BREACHOS (simulated).</div>
    <div style="margin-top:10px;">
      <div class="dim">CPU <span id="cpuPct"></span></div>
      <div class="progWrap"><div class="progFill" id="cpuBar" style="width:0%"></div></div>
      <div class="dim" style="margin-top:8px;">RAM <span id="ramPct"></span></div>
      <div class="progWrap"><div class="progFill" id="ramBar" style="width:0%"></div></div>
