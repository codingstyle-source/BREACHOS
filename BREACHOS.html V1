/* ---------------- terminal app (CLI, more commands) ---------------- */
const HELP=[
"commands:",
"  scan | hash | crack <h> | exploit 8080 | login root <pw>",
"  firewall on|off          - toggle the port 8080 firewall",
"  ls | cat <file>          - browse the fake filesystem",
"  ps | netstat | ifconfig  - system info",
"  ping <host>               - simulated ping",
"  trace <ip>                - simulated traceroute",
"  keylog start|stop         - toggle simulated keylogger",
"  rootkit install           - simulated rootkit install",
"  backdoor <port>           - open a simulated backdoor",
"  decrypt <file>            - decrypt a fake vault file",
"  neofetch | banner | matrix | date | history",
"  echo <text> | man <cmd> | sudo <cmd>",
"  status | clear | help"
].join('\n');
const FILES={'notes.txt':'reminder: change default password','vault.enc':'[ENCRYPTED] use: decrypt vault.enc','passwd':'root:5f4dcc3b5aa765d61d8327deb882cf99'};
function renderTerminal(c){
  c.innerHTML = `<div class="term"></div>
    <div class="termInputRow"><span class="termPrompt">${state.root?'root':(state.exploited?'breacher':'guest')}@breachos:~$</span>
    <input class="termCmd" autocomplete="off" autocapitalize="off" spellcheck="false"></div>`;
  const term=c.querySelector('.term');
  term.style.fontSize=settings.terminalFont+'px';
  const cmdIn=c.querySelector('.termCmd');
  const promptEl=c.querySelector('.termPrompt');
  const hist=[]; let histIdx=-1;
  if(settings.autoFocusTerm) cmdIn.focus();
  function tprint(t,cls){ const d=document.createElement('div'); if(cls)d.className=cls; d.textContent=t; term.appendChild(d); term.scrollTop=term.scrollHeight; }
  tprint('BREACHOS terminal. Type "help" for commands.','dim');
  cmdIn.addEventListener('keydown', async e=>{
    if(e.key==='ArrowUp'){ if(hist.length){ histIdx=Math.max(0,histIdx-1); cmdIn.value=hist[histIdx]||''; } e.preventDefault(); return; }
    if(e.key==='ArrowDown'){ if(hist.length){ histIdx=Math.min(hist.length,histIdx+1); cmdIn.value=hist[histIdx]||''; } e.preventDefault(); return; }
    if(e.key!=='Enter') return;
    const line=cmdIn.value.trim(); cmdIn.value='';
    if(!line) return;
    hist.push(line); histIdx=hist.length;
    tprint('$ '+line); beep(500);
    const [cmd,...rest]=line.split(/\s+/); const arg=rest.join(' ');
    switch(cmd){
      case 'help': tprint(HELP,'dim'); break;
      case 'status': tprint(JSON.stringify(state),'dim'); break;
      case 'clear': term.innerHTML=''; break;
      case 'date': tprint(new Date().toString(),'dim'); break;
      case 'history': tprint(hist.join('\n'),'dim'); break;
      case 'echo': tprint(arg); break;
      case 'ls': tprint(Object.keys(FILES).join('  ')); break;
      case 'cat':
        if(FILES[arg]) tprint(FILES[arg]); else tprint('No such file: '+arg,'err');
        break;
      case 'decrypt':
        if(arg==='vault.enc'){ if(!state.cracked){ tprint('Need a cracked password first.','err'); } else { tprint('vault.enc decrypted: "congrats, breacher"','ok'); } }
        else tprint('No such encrypted file.','err');
        break;
      case 'ps': tprint('PID  CMD\n1    breachd\n42   legacy-admin-panel\n88   debug-shelld','dim'); break;
      case 'netstat': tprint('Proto Local        State\ntcp   :22          LISTEN\ntcp   :8080        LISTEN\ntcp   :31337       CLOSED','dim'); break;
      case 'ifconfig': tprint('eth0: inet 127.0.0.1  netmask 255.0.0.0','dim'); break;
      case 'ping':
        if(!arg){ tprint('Usage: ping <host>','err'); break; }
        tprint(`Pinging ${arg}... 4 packets: 64 bytes time=${(Math.random()*20+1).toFixed(1)}ms`,'ok'); break;
      case 'trace':
        if(!arg){ tprint('Usage: trace <ip>','err'); break; }
        tprint(`1  localhost\n2  10.0.0.1\n3  ${arg}  [reached]`,'ok'); break;
      case 'keylog':
        if(arg==='start'){ state.keylog=true; tprint('Simulated keylogger started.','ok'); }
        else if(arg==='stop'){ state.keylog=false; tprint('Simulated keylogger stopped.','ok'); }
        else tprint('Usage: keylog start|stop','err');
        break;
      case 'rootkit':
        if(arg==='install'){ tprint('Simulated rootkit installed. (fictional, local only)','ok'); }
        else tprint('Usage: rootkit install','err');
        break;
      case 'backdoor':
        if(!arg){ tprint('Usage: backdoor <port>','err'); break; }
        tprint(`Simulated backdoor opened on port ${arg}.`,'ok'); break;
      case 'firewall':
        if(arg==='on'){ state.firewall=true; tprint('Firewall enabled.','ok'); }
        else if(arg==='off'){ state.firewall=false; tprint('Firewall disabled.','ok'); }
        else tprint('Usage: firewall on|off','err');
        break;
      case 'neofetch': tprint('BREACHOS v3.0\nUptime: '+Math.floor(performance.now()/1000)+'s\nShell: breachsh\nSession: '+(state.root?'root':state.exploited?'breacher':'guest'),'dim'); break;
      case 'banner': tprint('########  ######## ########    ###     ######  ##     ##  #######  ######','ok'); break;
      case 'man': tprint(arg?('Manual for "'+arg+'": simulated tool, no real system access.'):'Usage: man <cmd>','dim'); break;
      case 'sudo': tprint('You are already breaking in — sudo is redundant here.','dim'); break;
      case 'matrix':
        settings.matrixRain=!settings.matrixRain; applySettings();
        tprint('Matrix rain '+(settings.matrixRain?'enabled':'disabled')+'.','ok'); break;
      case 'scan': await runProgress(term,'Scanning...',800); state.scanned=true; tprint('Port 8080 vulnerable.','ok'); break;
      case 'hash':
        if(!state.scanned){tprint('Run scan first.','err');}
        else { await runProgress(term,'Dumping hash...',700); state.hash=true; tprint('hash: 5f4dcc3b5aa765d61d8327deb882cf99','ok'); }
        break;
      case 'crack':
        if(!state.hash){tprint('No hash.','err');}
        else { await runProgress(term,'Cracking...',1200); state.cracked=true; tprint('cracked: password','ok'); }
        break;
      case 'exploit':
        if(arg!=='8080'||!state.scanned){tprint('Usage: exploit 8080 (after scan)','err');}
        else if(state.firewall){ tprint('Blocked by firewall.','err'); }
        else { await runProgress(term,'Exploiting 8080...',1100); state.exploited=true; updateStatus(); promptEl.textContent='breacher@breachos:~$'; tprint('Foothold gained.','ok'); }
        break;
      case 'login':
        if(rest[0]!=='root'||!state.exploited||!state.cracked){ tprint('Need foothold + cracked password first.','err'); }
        else if(rest[1]!=='password'){ tprint('Wrong password.','err'); }
        else { await runProgress(term,'Authenticating...',600); state.root=true; updateStatus(); promptEl.textContent='root@breachos:~#'; tprint('ACCESS GRANTED — root@breachos','ok'); }
        break;
      default: tprint('Unknown command: '+cmd+' (try "help")','err');
    }
  });
}

