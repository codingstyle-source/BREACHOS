    <div class="out" id="procOut" style="font-size:11px;"></div>`;
  const cpuBar=c.querySelector('#cpuBar'), ramBar=c.querySelector('#ramBar'), netBar=c.querySelector('#netBar');
  const cpuPct=c.querySelector('#cpuPct'), ramPct=c.querySelector('#ramPct'), netPct=c.querySelector('#netPct');
  const procOut=c.querySelector('#procOut');
  let cpu=22, ram=34, net=8;
  function step(v,base){ v+=(Math.random()-0.5)*14; return Math.max(3,Math.min(97, v)); }
  function tick(){
    cpu=step(cpu); ram=step(ram); net=step(net);
    if(state.exploited) cpu=Math.min(97,cpu+15);
    if(state.root) ram=Math.min(97,ram+10);
    cpuBar.style.width=cpu.toFixed(0)+'%'; cpuPct.textContent=cpu.toFixed(0)+'%';
    ramBar.style.width=ram.toFixed(0)+'%'; ramPct.textContent=ram.toFixed(0)+'%';
    netBar.style.width=net.toFixed(0)+'%'; netPct.textContent=net.toFixed(0)+' KB/s';
    procOut.textContent =
`PID   NAME                 CPU%   MEM%
1     breachd              ${(cpu*0.3).toFixed(1).padStart(5)}  ${(ram*0.4).toFixed(1).padStart(5)}
42    legacy-admin-panel   ${(cpu*0.4).toFixed(1).padStart(5)}  ${(ram*0.3).toFixed(1).padStart(5)}
88    debug-shelld         ${(cpu*0.2).toFixed(1).padStart(5)}  ${(ram*0.2).toFixed(1).padStart(5)}`;
  }
  tick();
  const timer=setInterval(tick,1000);
  if(openWins[winId]) openWins[winId].cleanup=()=>clearInterval(timer);
}

